rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function signedInUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isAuth() && signedInUser().role == 'admin';
    }
    function isActiveMember() {
      let u = signedInUser();
      let trial = u.get('freeTrial', {});
      let hasTrial = u.keys().hasAny(['freeTrial']);
      let trialValid = trial.get('status', '') == 'active'
        && trial.get('expiresAt', request.time) > request.time;
      let paid = u.get('paid', false) == true || u.get('hasPaid', false) == true || u.get('adminOverride', false) == true;
      return isAuth() && u.status == 'active_member' && u.banned != true
        && (!hasTrial || trialValid || paid);
    }
    function isParticipant(matchId) {
      let users = get(/databases/$(database)/documents/matches/$(matchId)).data.users;
      return isAuth() && (users[0] == request.auth.uid || users[1] == request.auth.uid);
    }

    function matchHasBlock(matchId) {
      let users = get(/databases/$(database)/documents/matches/$(matchId)).data.users;
      return exists(/databases/$(database)/documents/users/$(users[0])/blocked/$(users[1]))
        || exists(/databases/$(database)/documents/users/$(users[1])/blocked/$(users[0]));
    }
    function ticketOwner() {
      return isAuth() && resource.data.uid == request.auth.uid;
    }
    function newTicketOwner() {
      return isAuth() && request.resource.data.uid == request.auth.uid;
    }
    function ticketIsOpenForUserReply() {
      return resource.data.status != 'closed';
    }
    function selfServiceStatus() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
        || request.resource.data.status in ['signedUp', 'pending_verification', 'pending_admin_review'];
    }
    function selfServiceSubscription() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription'])
        || (
          resource.data.subscription.status == 'active'
          && request.resource.data.subscription.diff(resource.data.subscription).affectedKeys()
            .hasOnly(['plan', 'billing', 'status', 'nextBillingDate', 'previousPlan', 'expiredAt', 'expiredBillingDate'])
          && request.resource.data.subscription.plan == 'standard'
          && request.resource.data.subscription.billing == 'included'
          && request.resource.data.subscription.status == 'expired'
          && request.resource.data.subscription.nextBillingDate == null
          && request.resource.data.subscription.previousPlan == resource.data.subscription.plan
          && request.resource.data.subscription.expiredBillingDate == resource.data.subscription.nextBillingDate
        );
    }
    // ── Standard plan daily swipe allowance (likes AND passes share it) ──
    // The daily number is set by the admin in config/pricing.standardDailyLikes.
    function standardDailyLimit() {
      let path = /databases/$(database)/documents/config/pricing;
      let n = exists(path) ? get(path).data.get('standardDailyLikes', 5) : 5;
      return n == 0 ? 5 : (n < 1 ? 1 : n);
    }
    function isPaidStandardUser(u) {
      let plan = u.get('plan', u.get('subscription', {}).get('plan', null));
      let trial = u.get('freeTrial', {});
      let isTrial = trial.get('status', '') == 'active'
        && trial.get('expiresAt', request.time) > request.time;
      let paid = u.get('hasPaid', false) == true
        || u.get('paid', false) == true
        || (u.get('status', '') == 'active_member' && !u.keys().hasAny(['freeTrial']));
      return paid && !isTrial && plan == 'standard';
    }
    function likesWindowExpired(u) {
      return u.get('likesResetAt', null) == null || u.likesResetAt <= request.time;
    }
    // Members may not raise their own counter: it can only go down, or be
    // reset to the admin's number when the 24h window has really expired.
    function likesChangeOk() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let b = resource.data;
      let a = request.resource.data;
      let lim = standardDailyLimit();
      let trial = b.get('freeTrial', {});
      let trialActive = trial.get('status', '') == 'active'
        && trial.get('expiresAt', request.time) > request.time;
      let hasTrial = b.keys().hasAny(['freeTrial']);
      return !keys.hasAny(['likesRemaining', 'likesResetAt', 'freeTrial'])
        || (hasTrial
            ? (trialActive
               && !keys.hasAny(['likesResetAt'])
               && a.likesRemaining >= 0
               && a.likesRemaining == b.get('likesRemaining', 1) - 1
               && a.freeTrial.likesUsed == trial.get('likesUsed', 0) + 1)
            : (!isPaidStandardUser(b)
               || (likesWindowExpired(b)
                 ? (a.get('likesRemaining', lim) in [lim, lim - 1]
                    && a.likesResetAt > request.time + duration.value(20, 'h')
                    && a.likesResetAt <= request.time + duration.value(30, 'h'))
                 : (!keys.hasAny(['likesResetAt'])
                    && a.likesRemaining >= 0
                    && a.likesRemaining <= b.get('likesRemaining', lim)))));
    }
    // A new like/pass by a paid Standard member must come with exactly one
    // swipe being used from the allowance, in the same write. Super likes use
    // the Super Like Pack instead.
    function swipeChargeOk(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      let b = get(userPath).data;
      let lim = standardDailyLimit();
      let expected = likesWindowExpired(b) ? lim - 1 : b.get('likesRemaining', lim) - 1;
      let trial = b.get('freeTrial', {});
      let trialActive = trial.get('status', '') == 'active'
        && trial.get('expiresAt', request.time) > request.time;
      let trialLikeExpected = b.get('likesRemaining', 1) - 1;
      let hasTrial = b.keys().hasAny(['freeTrial']);
      return (hasTrial
          ? (trialActive
             && (request.resource.data.direction == 'nope'
               || (request.resource.data.direction == 'like'
                 && trialLikeExpected >= 0
                 && getAfter(userPath).data.get('likesRemaining', -1) == trialLikeExpected
                 && getAfter(userPath).data.freeTrial.likesUsed == trial.get('likesUsed', 0) + 1)))
          : (!isPaidStandardUser(b)
             || request.resource.data.get('isSuperLike', false) == true
             || (expected >= 0 && getAfter(userPath).data.get('likesRemaining', -1) == expected)));
    }

    function selfRequestedReverification() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAll(['photos', 'verificationStatus'])
        && request.resource.data.verificationStatus == 'reverification_requested'
        && (!resource.data.keys().hasAny(['photos'])
          || !request.resource.data.keys().hasAny(['photos'])
          || resource.data.photos.size() == 0
          || request.resource.data.photos.size() == 0
          || request.resource.data.photos[0] != resource.data.photos[0]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isActiveMember();
      allow create: if isOwner(uid);
      allow update: if isAdmin() || (isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['walletBalance', 'walletFrozen', 'walletFrozenReason', 'walletFrozenAt', 'role', 'displayName'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus']) || selfRequestedReverification())
        && selfServiceStatus()
        && selfServiceSubscription()
        && likesChangeOk());
      // Allow members to update their own add-ons, location, and notification device fields only.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['addons', '_location', '_privacyPrefs', 'fcmTokens', 'fcmTokensUpdatedAt', 'pushNotificationsEnabledAt', 'seenAddToHomeScreenPrompt', 'seenAddToHomeScreenPromptAt']);
      allow delete: if isAdmin();

      match /swipes/{swipedUID} {
        allow read: if isOwner(uid) || isOwner(swipedUID) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.direction in ['like', 'superlike', 'nope']
          && swipeChargeOk(uid);
        allow update: if isOwner(uid)
          && request.resource.data.direction in ['like', 'superlike', 'nope'];
        allow delete: if isOwner(uid) || isAdmin();
      }
      match /matches/{matchUID} {
        allow read: if isOwner(uid) || isOwner(matchUID) || isAdmin();
        allow create, update: if isOwner(uid) || isOwner(matchUID) || isAdmin();
        allow delete: if isOwner(uid) || isOwner(matchUID) || isAdmin();
      }
      match /blocked/{blockedUID} {
        allow read: if isOwner(uid) || isOwner(blockedUID) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }
      match /walletTransactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin() || (isActiveMember() && !get(/databases/$(database)/documents/users/$(uid)).data.walletFrozen);
        allow update, delete: if isAdmin();
      }
    }

    match /matches/{matchId} {
      allow read: if isAdmin() || (isAuth() && request.auth.uid in resource.data.users);
      allow create: if isActiveMember()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users;
      allow update: if isAdmin() || (isAuth() && request.auth.uid in resource.data.users);
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isParticipant(matchId) || isAdmin();
        allow create: if isActiveMember() && isParticipant(matchId)
          && request.resource.data.senderUID == request.auth.uid
          && !matchHasBlock(matchId);
        allow update: if isAdmin() || (isParticipant(matchId) && request.resource.data.senderUID == resource.data.senderUID);
        allow delete: if isAdmin();
      }
    }

    match /videoCallInvites/{inviteId} {
      allow get: if isAdmin() || (isAuth() && (resource.data.fromUID == request.auth.uid || resource.data.toUID == request.auth.uid));
      allow list: if isAuth();
      allow create: if isAdmin() || (isAuth() && request.resource.data.fromUID == request.auth.uid)
        || (isAuth() && request.resource.data.fromUID == 'admin' && isAdmin());
      allow update: if isAdmin() || (isAuth() && (resource.data.fromUID == request.auth.uid || resource.data.toUID == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answeredAt', 'endedAt']));
    }

    match /swipes_index/{swipeId} {
      allow read: if isAuth() && (resource.data.myUID == request.auth.uid || resource.data.theirUID == request.auth.uid);
      allow create, update: if isActiveMember()
        && request.resource.data.myUID == request.auth.uid
        && request.resource.data.direction in ['like', 'superlike', 'nope'];
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isAuth() && request.resource.data.reporterUID == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /verification_calls/{callId} {
      allow read: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if newTicketOwner()
        && request.resource.data.status == 'open'
        && request.resource.data.uid is string;
      allow read: if isAdmin() || ticketOwner();
      allow update: if isAdmin();
      allow update: if ticketOwner()
        && ticketIsOpenForUserReply()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.status in ['open', 'waiting_user', 'pending_close', 'resolved'];
      allow delete: if isAdmin();
    }

    match /announcements/{annoId} {
      allow read: if isAuth();
      allow create, update, delete: if isAdmin();
    }

    match /admin_messages/{msgId} {
      allow read: if isAdmin() || (isAuth() && resource.data.toUID == request.auth.uid);
      allow create: if isAdmin() || isActiveMember();
      allow update: if isAdmin() || (
        isAuth()
        && resource.data.toUID == request.auth.uid
        && request.resource.data.toUID == resource.data.toUID
      );
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create: if isActiveMember() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    match /admin_audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /otp_verifications/{otpId} {
      allow read, write: if false;
    }

    match /priority_support_requests/{requestId} {
      allow read: if isAdmin() || (isAuth() && resource.data.uid == request.auth.uid);
      allow create: if isActiveMember() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Admin global settings (location/distance/age toggles)
    match /admin/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
